{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigestsToSemver"
    ],
    "timezone": "Europe/Oslo",
    "schedule": [
        "before 7am on monday"
    ],
    "dependencyDashboard": true,
    "github-actions": {
        "enabled": true
    },
    "gomod": {
        "enabled": true
    },
    "mise": {
        "enabled": true
    },
    "pre-commit": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Keep the Go version in go.mod and mise.toml in sync",
            "matchDepNames": [
                "go"
            ],
            "groupName": "go"
        },
        {
            "description": "One PR for all GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github actions"
        }
    ]
}
